{
  "project_name": "Vesper V2 Native Android TV App",
  "app_type": "native_android_tv_app",
  "design_archetype": "THE PERFORMANCE PRO / NEON-GLASS (V2 Electric)",
  "reference_viewport": {
    "web_px": "1920x1080",
    "native_dp": "960x540",
    "conversion": "1dp = 2px (divide web px by 2)"
  },
  "typography": {
    "font_family_primary": "Geist",
    "font_family_mono": "Geist Mono / JetBrains Mono",
    "h1_hero": {
      "font_size_sp": 30,
      "web_size_px": 60,
      "font_weight": "700 (Bold)",
      "letter_spacing": "-0.025em",
      "line_height": 1.0
    },
    "h2_section": {
      "font_size_sp": 20,
      "web_size_px": 40,
      "font_weight": "700 (Bold)",
      "letter_spacing": "-0.015em"
    },
    "h3_card_title": {
      "font_size_sp": 14,
      "web_size_px": 28,
      "font_weight": "600 (SemiBold)",
      "letter_spacing": "normal"
    },
    "body_text": {
      "font_size_sp": 12,
      "web_size_px": 24,
      "font_weight": "400 (Regular)",
      "line_height": 1.45
    },
    "eyebrow_label": {
      "font_size_sp": 10,
      "web_size_px": 20,
      "font_weight": "500 (Medium)",
      "letter_spacing": "1.6sp",
      "text_transform": "uppercase"
    }
  },
  "colors": {
    "vesper_bg_0": "#06080F",
    "vesper_bg_1": "#0A0E1A",
    "vesper_bg_2": "#111827",
    "vesper_surface": "#1A2238",
    "vesper_surface_2": "#232C47",
    "vesper_text_primary": "#F5F7FA",
    "vesper_text_secondary": "#9BA8C2",
    "vesper_text_muted": "#5B6580",
    "vesper_blue_signal": "#5DC8FF",
    "vesper_blue_bright": "#8DE0FF",
    "vesper_blue_glow": "rgba(93, 200, 255, 0.55)",
    "vesper_border_line": "rgba(255, 255, 255, 0.07)",
    "error_red": "#FF8B7C"
  },
  "visual_enhancers": {
    "focus_ring": {
      "style": "solid_cyan_outline",
      "stroke_width_dp": 1.5,
      "color": "#8DE0FF",
      "outline_offset_dp": 2,
      "scale_pop": 1.06,
      "transition_ms": 120,
      "easing": "ease-out"
    },
    "pill_focus": {
      "scale_pop": 1.04,
      "border_width_dp": 2,
      "border_color": "#8DE0FF",
      "shadow_glow": "0 0 22px 4px rgba(93, 200, 255, 0.55)"
    },
    "scrim_gradients": {
      "bottom_dock": "vertical gradient transparent -> rgba(2, 6, 16, 0.6) -> rgba(2, 6, 16, 0.92)",
      "hero_bottom": "vertical gradient transparent -> #06080F"
    }
  },
  "grids": {
    "poster_2_3": {
      "width_dp": 80,
      "height_dp": 120,
      "corner_radius_dp": 6,
      "gap_dp": 12
    },
    "landscape_16_9": {
      "width_dp": 128,
      "height_dp": 72,
      "corner_radius_dp": 6,
      "gap_dp": 12
    },
    "genre_grid": {
      "columns_native": 6,
      "gap_dp": 16
    }
  },
  "layouts": {
    "top_nav": {
      "height_dp": 36,
      "padding_horizontal_dp": 24,
      "item_gap_dp": 8,
      "active_indicator": "cyan_glow_pill"
    },
    "hero_billboard": {
      "height_dp": 210,
      "left_inset_dp": 32,
      "title_size_sp": 22,
      "synopsis_max_lines": 3
    },
    "control_dock": {
      "height_dp": 180,
      "padding_horizontal_dp": 32,
      "padding_bottom_dp": 32,
      "play_pause_button_size_dp": 40,
      "action_button_size_dp": 28
    }
  },
  "motion": {
    "dpad_focus_snap": "120ms ease-out scale pop-out",
    "scrub_debounce_ms": 220,
    "dock_autohide_delay_ms": 5000,
    "reduced_motion_handling": "disable scale animations, preserve sharp cyan outline"
  },
  "accessibility": {
    "min_contrast_ratio": "4.5:1",
    "test_id_convention": "R.id.test_id / data-testid in kebab-case",
    "touch_and_remote_hit_target_min_dp": 42
  },
  "media": {
    "engine_support": ["mpv", "vlc", "exo", "exo_ffmpeg"],
    "player_overlay": "Native PlayerOverlay Compose / Views layout above Media3 PlayerView",
    "aspect_ratios": ["fit", "fill", "zoom", "stretch"]
  },
  "3d_libraries": {
    "usage": "None (Pure 2D Native TV Performance Focus)"
  },
  "image_urls": {
    "note": "Source of truth artwork is bundled in app resources and assets",
    "bundled_assets_path": "/app/android/vesper-native/app/src/main/assets/",
    "bundled_res_path": "/app/android/vesper-native/app/src/main/res/"
  },
  "component_path": {
    "ui_primitives": "/app/android/vesper-native/app/src/main/java/tv/onnowtv/vespernative/ui/TvUi.kt",
    "focus_motion": "/app/android/vesper-native/app/src/main/java/tv/onnowtv/vespernative/ui/FocusMotion.kt",
    "player_overlay": "/app/android/vesper-tv/app/src/main/java/tv/vesper/app/PlayerOverlay.kt",
    "home_screen": "/app/android/vesper-native/app/src/main/java/tv/onnowtv/vespernative/ui/HomeScreen.kt"
  },
  "instructions_to_main_agent": [
    "Strictly maintain pixel and geometry conversions (1dp = 2px at 1080p).",
    "Ensure clipChildren=false and clipToPadding=false on all scroll/grid containers to prevent focus ring clipping.",
    "Retain existing ExoPlayer/Media3 lifecycle and active audio/subtitle track detection without fake active controls.",
    "Use R.id.test_id or data-testid on every interactive view for automated testing."
  ],
  "UNIVERSAL GUIDELINES FOR MAIN AGENT": [
    "Do not invent new aesthetic directions or gradients.",
    "Do not add universal transition CSS or Kotlin animations that cause ghosting.",
    "Ensure all focusable elements have high contrast focus outlines and accessible touch/remote hit targets."
  ]
}