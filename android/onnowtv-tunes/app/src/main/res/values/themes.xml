<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OnNowTunes" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/tunes_bg</item>
        <item name="android:statusBarColor">@color/tunes_bg</item>
        <item name="android:navigationBarColor">@color/tunes_bg</item>
        <item name="colorPrimary">@color/tunes_accent</item>
        <item name="colorPrimaryDark">@color/tunes_bg_dark</item>
        <item name="colorAccent">@color/tunes_accent</item>
    </style>
    <style name="Theme.OnNowTunes.NoActionBar" parent="Theme.OnNowTunes">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!--
        v2.16.7 — Cold-start splash.  Applied to MainActivity so the
        OS paints @drawable/splash_tunes as the very first frame,
        masking the ~1s WebView cold-boot delay behind the Tunes
        brand backdrop.  MainActivity.onCreate calls setTheme
        (NoActionBar) BEFORE super.onCreate so the rest of the app
        renders under the normal theme.
    -->
    <style name="Theme.OnNowTunes.Splash" parent="Theme.OnNowTunes.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_tunes</item>
    </style>
</resources>
