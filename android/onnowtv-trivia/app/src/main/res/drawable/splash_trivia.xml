<?xml version="1.0" encoding="utf-8"?>
<!--
    Trivia cold-start splash background.

    Painted by the OS the instant the launcher hands control to the
    app — prevents the ~1s black flash while the WebView cold-boots.
    Palette matches the Trivia lobby (midnight slate + warm coral /
    indigo blooms) so splash → first WebView paint is seamless.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/trivia_bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="700dp"
                android:centerX="0.88"
                android:centerY="0.08"
                android:startColor="#2E5DC8FF"
                android:centerColor="#145DC8FF"
                android:endColor="#0006080F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="600dp"
                android:centerX="0.05"
                android:centerY="0.95"
                android:startColor="#2E2A82B8"
                android:centerColor="#142A82B8"
                android:endColor="#0006080F" />
        </shape>
    </item>
</layer-list>
