<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="Vesper Native · Dev" android:theme="@style/Theme.VesperNative"
        android:icon="@drawable/app_icon" android:banner="@drawable/tv_banner"
        android:allowBackup="false" android:usesCleartextTraffic="false"
        android:supportsRtl="true">
        <!-- LAUNCHER is intentional: generic Android TV boxes may lack Leanback. -->
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="landscape" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>