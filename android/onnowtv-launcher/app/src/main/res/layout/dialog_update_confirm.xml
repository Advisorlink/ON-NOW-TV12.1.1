<?xml version="1.0" encoding="utf-8"?>
<!--
    v2.16.27 — Simplified update-confirm dialog.  The "Back up profiles
    first" button was removed because Vesper now performs an automatic
    cloud backup keyed to the user's login on every profile change, so
    updating never risks data loss.  Layout is now: UPDATE AVAILABLE
    badge → title → body copy → reassurance note ("your profiles are
    safe") → two buttons (primary UPDATE, ghost CANCEL).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/update_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_update_dialog_card"
    android:padding="28dp">

    <!-- Header pill — cyan-tinted UPDATE badge, echoes the "UPDATE ·
         v2.10.75" pill already used on tiles. -->
    <TextView
        android:id="@+id/update_dialog_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="@drawable/bg_update_dialog_btn_secondary"
        android:textColor="#FF2BB6FF"
        android:textSize="11sp"
        android:letterSpacing="0.14"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:text="UPDATE AVAILABLE" />

    <!-- Title -->
    <TextView
        android:id="@+id/update_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:textColor="#FFF4F7FB"
        android:textSize="22sp"
        android:letterSpacing="0.01"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        tools:text="Update Movies/TV?" />

    <!-- Body copy -->
    <TextView
        android:id="@+id/update_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#FF8EA0B7"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:fontFamily="sans-serif"
        tools:text="This will replace the currently-installed version with the latest one from the store." />

    <!-- v2.16.27 — Reassurance note.  Sits between the body copy and
         the buttons.  Uses a rounded chip background + soft cyan tint
         so the user's eye lands on it and they know updating is safe. -->
    <TextView
        android:id="@+id/update_dialog_reassurance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:background="@drawable/bg_update_dialog_btn_secondary"
        android:textColor="#FFAEE4FF"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp"
        android:fontFamily="sans-serif"
        android:text="Don&#8217;t worry, your profiles are safely saved to your login." />

    <!-- Two-button row: primary UPDATE + ghost CANCEL. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/update_dialog_btn_install"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_update_dialog_btn_primary"
            android:textColor="#FF04060B"
            android:textSize="13sp"
            android:letterSpacing="0.08"
            android:paddingHorizontal="12dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="none"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusRight="@id/update_dialog_btn_cancel"
            android:nextFocusLeft="@id/update_dialog_btn_install"
            android:text="Update" />

        <Button
            android:id="@+id/update_dialog_btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:paddingHorizontal="22dp"
            android:background="@drawable/bg_update_dialog_btn_ghost"
            android:textColor="#FF8EA0B7"
            android:textSize="13sp"
            android:letterSpacing="0.08"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusLeft="@id/update_dialog_btn_install"
            android:nextFocusRight="@id/update_dialog_btn_cancel"
            android:text="Cancel" />
    </LinearLayout>
</LinearLayout>
