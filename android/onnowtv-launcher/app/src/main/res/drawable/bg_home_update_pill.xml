<?xml version="1.0" encoding="utf-8"?>
<!-- HOME UPDATE pill on the home screen.  Same cyan→blue→indigo
     gradient as the App Store pill; focused state adds a bright
     white ring so the D-pad highlight is unmistakable. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="315"
                android:startColor="#FF06B6D4"
                android:centerColor="#FF2563EB"
                android:endColor="#FF4F46E5" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="315"
                android:startColor="#FF06B6D4"
                android:centerColor="#FF2563EB"
                android:endColor="#FF4F46E5" />
            <stroke android:width="1dp" android:color="#662BB6FF" />
        </shape>
    </item>
</selector>
