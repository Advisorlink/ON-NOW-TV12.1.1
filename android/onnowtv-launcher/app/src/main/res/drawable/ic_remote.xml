<!--
  Phone-remote icon for the launcher top bar.  Sits beside the
  headset (support) icon.  Pressing OK opens RemoteControlActivity
  which shows a QR + 6-digit code to pair a phone as a remote.

  Drawn as a TV remote: rounded body, a round D-pad ring with a
  centre OK dot, and a couple of button rows below.  Matches the
  2px stroke weight of ic_wifi / ic_support_headset.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Remote body -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M8,2 h8 a3,3 0 0,1 3,3 v14 a3,3 0 0,1 -3,3 h-8 a3,3 0 0,1 -3,-3 v-14 a3,3 0 0,1 3,-3 z" />
    <!-- D-pad ring -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:fillColor="#00000000"
        android:pathData="M12,5.4 m-3.1,0 a3.1,3.1 0 1,0 6.2,0 a3.1,3.1 0 1,0 -6.2,0" />
    <!-- Centre OK dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,5.4 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0" />
    <!-- Button row 1 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M9,12.6 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M15,12.6 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0" />
    <!-- Button row 2 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M9,16.4 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M15,16.4 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0" />
</vector>
