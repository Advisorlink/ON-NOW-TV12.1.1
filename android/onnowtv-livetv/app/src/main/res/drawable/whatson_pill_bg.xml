<?xml version="1.0" encoding="utf-8"?>
<!-- "WHAT'S ON LIVE" premium pill background.  Distinctive from
     the regular category rows: red→orange horizontal gradient with
     a bright coral border, plus a warm outer glow when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="#33FF6E38" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="0"
                        android:startColor="#FF2535"
                        android:centerColor="#FF4A2C"
                        android:endColor="#FF8C2A" />
                    <corners android:radius="9dp" />
                    <stroke android:width="1dp" android:color="#FFCFA1" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#FF2535"
                android:centerColor="#FF4A2C"
                android:endColor="#FF8C2A" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#FFB08A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#CC2E1216"
                android:centerColor="#CC3A1810"
                android:endColor="#CC4A2211" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#66FF6A38" />
        </shape>
    </item>
</selector>
