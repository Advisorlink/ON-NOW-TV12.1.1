    <item android:state_pressed="true"><shape><solid android:color="#0A0F1A"/><stroke android:width="2dp" android:color="#5DC8FF"/><corners android:radius="14dp"/></shape></item>
    <item><shape><solid android:color="#0A0F1A"/><stroke android:width="1dp" android:color="#555DC8FF"/><corners android:radius="14dp"/></shape></item>
