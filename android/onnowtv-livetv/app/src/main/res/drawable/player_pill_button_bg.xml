<?xml version="1.0" encoding="utf-8"?>
<!-- v2.12 SWAP BACK pill — dark pill, app-blue (#5DC8FF) ring when
     D-pad focused.  Matches the accent used across the rest of
     the Live TV UI. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#FF333B43" />
            <stroke android:width="2dp" android:color="#5DC8FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#FF333B43" />
            <stroke android:width="2dp" android:color="#5DC8FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#E62A3038" />
        </shape>
    </item>
</selector>
