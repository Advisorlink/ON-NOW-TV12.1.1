<?xml version="1.0" encoding="utf-8"?>
<!-- Bright red LIVE indicator dot with a soft outer glow ring.
     Combined with an infinite alpha pulse animation at runtime. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#33FF3B4A" />
            <size android:width="14dp" android:height="14dp" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="#FFFF3B4A" />
        </shape>
    </item>
</layer-list>
