<?xml version="1.0" encoding="utf-8"?>
<!-- v2.12 Play/Pause circle — permanent app-blue ring (#5DC8FF)
     matching the rest of the Live TV accent palette.  Fills
     faintly + thickens when D-pad focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#405DC8FF" />
            <stroke android:width="3dp" android:color="#5DC8FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#405DC8FF" />
            <stroke android:width="3dp" android:color="#5DC8FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#66101418" />
            <stroke android:width="2dp" android:color="#5DC8FF" />
        </shape>
    </item>
</selector>
