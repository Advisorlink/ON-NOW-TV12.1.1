<?xml version="1.0" encoding="utf-8"?>
<!-- v2.12 Bottom banner backdrop — user preference: TOP FADED,
     BOTTOM SOLID.  angle=270 means the gradient runs top → bottom,
     so startColor is at the TOP (fully transparent) and endColor
     is at the BOTTOM (near-opaque black).  This lets the movie
     bleed through the top edge of the banner while keeping the
     lower part rock-solid for text readability. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#00070A0D"
        android:centerColor="#B3070A0D"
        android:endColor="#F5070A0D" />
</shape>
