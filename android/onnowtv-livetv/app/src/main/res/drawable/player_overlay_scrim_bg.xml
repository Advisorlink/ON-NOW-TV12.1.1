<?xml version="1.0" encoding="utf-8"?>
<!-- v2.11 Bottom banner backdrop — the reference lets the movie show
     faintly behind the banner, so we use a transparent → near-black
     vertical fade.  Text stays readable because the lower 2/3 is
     ~95% opaque. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#26070A0D"
        android:centerColor="#E6070A0D"
        android:endColor="#F5070A0D" />
</shape>
