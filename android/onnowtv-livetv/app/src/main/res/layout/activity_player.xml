<?xml version="1.0" encoding="utf-8"?>
<!--
    v2.11 — Full-screen ExoPlayer with the reference-image overlay.

    Layers (back → front):
      1) PlayerView (the actual video)
      2) Buffering loader (centered, neon blue)
      3) Tune-in pill (top-right — typed channel digits)
      4) Top-right CLOCK / DATE column
      5) Bottom info banner — reference design:
         [LCN badge] [logo] [title / channel • times / synopsis] [UP NEXT card]
         [elapsed] [teal progress bar] [duration] [SWAP BACK] [⏸] [CC]
      6) Status / error text (centered)

    Designed for 1920×1080 (16:9).  All paddings/sizes are dp and
    scale cleanly on other TV sizes.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <!-- ─────────── (1) Video surface ─────────── -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:use_controller="false"
        app:show_buffering="never" />

    <!-- ─────────── (2) Orbital buffering loader (centred) ─────────── -->
    <tv.onnowtv.livetv.ui.OrbitalLoaderView
        android:id="@+id/buffer_loader"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- ─────────── (3) Tune-in pill (top-right) ─────────── -->
    <TextView
        android:id="@+id/tune_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="36dp"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:background="@drawable/tune_pill_bg"
        android:textColor="#5DC8FF"
        android:textSize="22sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.12"
        android:visibility="gone"
        tools:ignore="HardcodedText"
        tools:text="→ 21…" />

    <!-- ─────────── (4) Top-right CLOCK / DATE ─────────── -->
    <LinearLayout
        android:id="@+id/player_clock_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="48dp"
        android:orientation="vertical"
        android:gravity="end"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/player_clock_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="44sp"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                tools:text="9:15" />

            <TextView
                android:id="@+id/player_clock_ampm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="6dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                tools:text="PM" />
        </LinearLayout>

        <TextView
            android:id="@+id/player_clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:textColor="#5DC8FF"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.04"
            tools:text="Sat, May 25" />
    </LinearLayout>

    <!-- ─────────── (5) Bottom info banner — v2.11 reference design ─────────── -->
    <LinearLayout
        android:id="@+id/player_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/player_overlay_scrim_bg"
        android:visibility="gone">

        <!-- ── Info row: [badge] [logo] [now info] [UP NEXT card] ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="40dp"
            android:paddingTop="26dp"
            android:paddingBottom="4dp">

            <!-- Channel number badge (rounded square, like "8" in the reference) -->
            <TextView
                android:id="@+id/player_info_lcn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:background="@drawable/player_lcn_badge_bg"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                tools:text="8" />

            <!-- Channel logo -->
            <ImageView
                android:id="@+id/player_info_logo"
                android:layout_width="96dp"
                android:layout_height="54dp"
                android:layout_marginStart="18dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                tools:src="@android:drawable/ic_menu_gallery" />

            <!-- CENTER column: NOW programme info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:orientation="vertical">

                <!-- Programme title — big and bold like "Classic Cinema" -->
                <TextView
                    android:id="@+id/player_info_programme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:ellipsize="end"
                    tools:text="Classic Cinema" />

                <!-- Meta line: channel name • start – end times -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/player_info_channel_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#D6DDE6"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:maxWidth="320dp"
                        tools:text="Retro Vault" />

                    <TextView
                        android:id="@+id/player_info_time_range"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#9AA6B2"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:singleLine="true"
                        tools:text="  •  8:00 PM – 10:00 PM" />
                </LinearLayout>

                <!-- Synopsis / description -->
                <TextView
                    android:id="@+id/player_info_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:textColor="#AEB8C4"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="A timeless classic from the golden age of cinema." />
            </LinearLayout>

            <!-- UP NEXT card (right side, teal accent, like the reference) -->
            <LinearLayout
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/player_upnext_card_bg"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UP NEXT"
                        android:textColor="#5DC8FF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.22"
                        tools:ignore="HardcodedText" />

                    <View
                        android:layout_width="30dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="4dp"
                        android:background="#5DC8FF" />

                    <TextView
                        android:id="@+id/player_info_next_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:ellipsize="end"
                        tools:text="Vintage Thrills" />

                    <TextView
                        android:id="@+id/player_info_next_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="#9AA6B2"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif"
                        android:singleLine="true"
                        android:ellipsize="end"
                        tools:text="A high-energy hour of vintage adventure." />

                    <TextView
                        android:id="@+id/player_info_next_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#D6DDE6"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        tools:text="10:00 PM" />
                </LinearLayout>

                <!-- v2.12 UP NEXT thumbnail — small 16:9 cover-art
                     rectangle, filled with a TMDB backdrop for the
                     next programme (falls back to the channel logo). -->
                <ImageView
                    android:id="@+id/player_info_next_thumb"
                    android:layout_width="112dp"
                    android:layout_height="63dp"
                    android:layout_gravity="center_vertical"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null"
                    tools:src="@android:drawable/ic_menu_gallery" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Progress + controls row ── -->
        <!-- [elapsed] [teal progress bar] [duration] [SWAP BACK] [⏸] [CC] -->
        <LinearLayout
            android:id="@+id/player_controls_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="40dp"
            android:paddingTop="16dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/player_info_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#D6DDE6"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                tools:text="47:20" />

            <ProgressBar
                android:id="@+id/player_info_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="14dp"
                android:progressDrawable="@drawable/player_progress_bar"
                android:max="1000"
                android:progress="540" />

            <TextView
                android:id="@+id/player_info_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:textColor="#8F99A6"
                android:textSize="12sp"
                android:fontFamily="sans-serif"
                tools:text="1:31:05" />

            <!-- SWAP BACK pill -->
            <LinearLayout
                android:id="@+id/btn_player_swap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:paddingVertical="11dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/player_pill_button_bg"
                android:focusable="true"
                android:clickable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_player_swap"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:text="SWAP BACK"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <!-- Play / Pause circle (teal ring) -->
            <ImageButton
                android:id="@+id/btn_player_playpause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="14dp"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:background="@drawable/player_circle_teal_bg"
                android:src="@drawable/ic_player_pause"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="Play / Pause" />

            <!-- Subtitles / CC circle -->
            <ImageButton
                android:id="@+id/btn_player_subtitles"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:background="@drawable/player_circle_neutral_bg"
                android:src="@drawable/ic_player_cc"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="Subtitles" />
        </LinearLayout>
    </LinearLayout>

    <!-- ─────────── Status / error text ─────────── -->
    <TextView
        android:id="@+id/player_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:visibility="gone"
        tools:text="" />

    <!-- ─────────── Legacy hidden views (kept so old code paths still resolve) ─────────── -->
    <LinearLayout
        android:id="@+id/info_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <ImageView android:id="@+id/info_logo"
            android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/info_channel"
            android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/info_lcn"
            android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/info_now_title"
            android:layout_width="0dp" android:layout_height="0dp" />
        <ProgressBar android:id="@+id/info_progress"
            android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/info_up_next"
            android:layout_width="0dp" android:layout_height="0dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_info_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <ImageView android:id="@+id/player_info_logo_legacy"
            android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/player_info_channel"
            android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/player_info_programme_legacy"
            android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/player_info_description_legacy"
            android:layout_width="0dp" android:layout_height="0dp" />
    </LinearLayout>

    <!-- v2.11 — controls removed from the visible banner by the new
         reference design.  Kept as hidden, unfocusable 0×0 views so
         all PlayerActivity findViewById/wiring still resolves.
         Channel zapping stays on D-pad UP + CH± remote keys. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <ImageButton android:id="@+id/btn_player_rewind"
            android:layout_width="0dp" android:layout_height="0dp"
            android:focusable="false" android:contentDescription="@null" />
        <ImageButton android:id="@+id/btn_player_forward"
            android:layout_width="0dp" android:layout_height="0dp"
            android:focusable="false" android:contentDescription="@null" />
        <ImageButton android:id="@+id/btn_player_chup"
            android:layout_width="0dp" android:layout_height="0dp"
            android:focusable="false" android:contentDescription="@null" />
        <ImageButton android:id="@+id/btn_player_chdown"
            android:layout_width="0dp" android:layout_height="0dp"
            android:focusable="false" android:contentDescription="@null" />
        <ImageButton android:id="@+id/btn_player_favorite"
            android:layout_width="0dp" android:layout_height="0dp"
            android:focusable="false" android:contentDescription="@null" />
        <TextView android:id="@+id/btn_player_playpause_label"
            android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/player_info_live_red"
            android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/player_info_live_chip"
            android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/player_info_segment"
            android:layout_width="0dp" android:layout_height="0dp" />
    </LinearLayout>

    <!-- Legacy buttons referenced in earlier PlayerActivity code -->
    <ImageButton android:id="@+id/btn_player_aspect"
        android:layout_width="0dp" android:layout_height="0dp"
        android:visibility="gone" android:focusable="false"
        android:contentDescription="@null" />
    <ImageButton android:id="@+id/btn_player_info"
        android:layout_width="0dp" android:layout_height="0dp"
        android:visibility="gone" android:focusable="false"
        android:contentDescription="@null" />
</FrameLayout>
