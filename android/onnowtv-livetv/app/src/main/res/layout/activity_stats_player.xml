<?xml version="1.0" encoding="utf-8"?>
<!-- v2.15.0 — Live Sports Match Centre (split-screen stats mode).

     Broadcast-style 2×2 grid:
       ┌────────────────┬────────────────┐
       │  VIDEO (¼ scr) │  SCOREBOARD    │
       ├────────────────┼────────────────┤
       │  TIMELINE      │  MATCH STATS   │
       └────────────────┴────────────────┘
     Periods table + stat bars + event rows are built in code by
     StatsPlayerActivity from the normalized /api/livestats/board
     payload so every sport renders through the same layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#070C16"
    android:padding="16dp"
    android:keepScreenOn="true">

    <!-- ── TOP ROW: video + scoreboard ─────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="52"
        android:orientation="horizontal">

        <!-- Video card (focusable → OK = fullscreen) -->
        <FrameLayout
            android:id="@+id/stats_video_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="50"
            android:layout_marginEnd="14dp"
            android:background="@drawable/stats_video_focus_bg"
            android:clipToOutline="true"
            android:focusable="true"
            android:clickable="true">

            <androidx.media3.ui.PlayerView
                android:id="@+id/stats_player_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                app:resize_mode="fit"
                app:use_controller="false"
                app:show_buffering="never" />

            <tv.onnowtv.livetv.ui.OrbitalLoaderView
                android:id="@+id/stats_buffer_loader"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/stats_fullscreen_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="10dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/stats_clock_pill_bg"
                android:text="OK · FULLSCREEN"
                android:textColor="#9DB6D8"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/stats_channel_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/stats_clock_pill_bg"
                android:textColor="#C9D4E8"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:singleLine="true" />
        </FrameLayout>

        <!-- Scoreboard card -->
        <LinearLayout
            android:id="@+id/stats_score_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="50"
            android:orientation="vertical"
            android:background="@drawable/stats_card_bg"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/stats_league_eyebrow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#7A8AB2"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/stats_sport_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="#5DC8FF"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.1"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/stats_live_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/stats_live_pill_bg"
                    android:text="● LIVE"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:visibility="gone" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- Live scoreboard content -->
                <LinearLayout
                    android:id="@+id/stats_score_group"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Home block -->
                        <LinearLayout
                            android:id="@+id/stats_home_block"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <ImageView
                                android:id="@+id/stats_home_logo"
                                android:layout_width="58dp"
                                android:layout_height="58dp"
                                android:scaleType="fitCenter"
                                android:contentDescription="Home team" />

                            <TextView
                                android:id="@+id/stats_home_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:maxLines="2"
                                android:textColor="#F5F8FF"
                                android:textSize="15sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/stats_home_form"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textSize="10sp"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.3"
                                android:visibility="gone" />

                            <View
                                android:id="@+id/stats_home_underline"
                                android:layout_width="26dp"
                                android:layout_height="3dp"
                                android:layout_marginTop="6dp"
                                android:background="#5DC8FF" />
                        </LinearLayout>

                        <!-- Score centre -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingHorizontal="10dp">

                            <TextView
                                android:id="@+id/stats_score"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FFFFFF"
                                android:textSize="48sp"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="-0.02" />

                            <TextView
                                android:id="@+id/stats_score_detail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="#8A9AC0"
                                android:textSize="12sp"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.1"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/stats_clock_pill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="5dp"
                                android:background="@drawable/stats_clock_pill_bg"
                                android:textColor="#5DC8FF"
                                android:textSize="14sp"
                                android:fontFamily="monospace" />
                        </LinearLayout>

                        <!-- Away block -->
                        <LinearLayout
                            android:id="@+id/stats_away_block"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <ImageView
                                android:id="@+id/stats_away_logo"
                                android:layout_width="58dp"
                                android:layout_height="58dp"
                                android:scaleType="fitCenter"
                                android:contentDescription="Away team" />

                            <TextView
                                android:id="@+id/stats_away_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:maxLines="2"
                                android:textColor="#F5F8FF"
                                android:textSize="15sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:id="@+id/stats_away_form"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textSize="10sp"
                                android:fontFamily="monospace"
                                android:letterSpacing="0.3"
                                android:visibility="gone" />

                            <View
                                android:id="@+id/stats_away_underline"
                                android:layout_width="26dp"
                                android:layout_height="3dp"
                                android:layout_marginTop="6dp"
                                android:background="#FF7A4D" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/stats_status_long"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:textColor="#9DA5B5"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- Waiting / unavailable state -->
                <LinearLayout
                    android:id="@+id/stats_wait_group"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingHorizontal="24dp">

                    <tv.onnowtv.livetv.ui.OrbitalLoaderView
                        android:id="@+id/stats_wait_loader"
                        android:layout_width="52dp"
                        android:layout_height="52dp" />

                    <TextView
                        android:id="@+id/stats_wait_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:text="SEARCHING FOR LIVE MATCH DATA…"
                        android:textColor="#9DA5B5"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.04" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/stats_venue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#55627E"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="14dp" />

    <!-- ── BOTTOM ROW: timeline + match stats ──────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="48"
        android:orientation="horizontal">

        <!-- Timeline / events / F1 leaderboard -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="50"
            android:layout_marginEnd="14dp"
            android:orientation="vertical"
            android:background="@drawable/stats_card_bg"
            android:padding="16dp">

            <TextView
                android:id="@+id/stats_events_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MATCH TIMELINE"
                android:textColor="#7A8AB2"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.14"
                android:paddingBottom="10dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:focusable="false">

                <LinearLayout
                    android:id="@+id/stats_events_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/stats_events_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="20dp"
                android:text="EVENT FEED UNAVAILABLE FOR THIS SPORT — SCORES REFRESH AUTOMATICALLY"
                android:textColor="#55627E"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.04"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Match stats: periods table + head-to-head bars -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="50"
            android:orientation="vertical"
            android:background="@drawable/stats_card_bg"
            android:padding="16dp">

            <TextView
                android:id="@+id/stats_stats_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MATCH STATS"
                android:textColor="#7A8AB2"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.14"
                android:paddingBottom="10dp" />

            <LinearLayout
                android:id="@+id/stats_periods_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:focusable="false">

                <LinearLayout
                    android:id="@+id/stats_bars_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <TextView
                android:id="@+id/stats_stats_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingVertical="20dp"
                android:text="DETAILED STATS NOT AVAILABLE FOR THIS MATCH YET"
                android:textColor="#55627E"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.04"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
