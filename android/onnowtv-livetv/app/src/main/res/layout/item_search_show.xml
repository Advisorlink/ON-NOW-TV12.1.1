<?xml version="1.0" encoding="utf-8"?>
<!-- Search programme card: cover art + title + when/where + description. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="118dp"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal"
    android:background="@drawable/channel_pill_bg"
    android:focusable="true"
    android:clickable="true"
    android:padding="10dp">

    <FrameLayout
        android:layout_width="176dp"
        android:layout_height="99dp"
        android:background="@drawable/channel_logo_bg">

        <ImageView
            android:id="@+id/ss_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/ss_logo"
            android:layout_width="44dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="6dp"
            android:padding="3dp"
            android:background="#B3000000"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/ss_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@color/livetv_accent_red"
            android:fontFamily="monospace"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:text="LIVE" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="18dp"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/ss_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/livetv_fg"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/ss_reminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/channel_count_chip_bg"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.16" />
        </LinearLayout>

        <TextView
            android:id="@+id/ss_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="@color/livetv_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:ellipsize="end"
            android:maxLines="1" />

        <ProgressBar
            android:id="@+id/ss_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="7dp"
            android:max="1000"
            android:progressDrawable="@drawable/player_progress_bar" />

        <TextView
            android:id="@+id/ss_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/livetv_fg_dim"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:ellipsize="end"
            android:maxLines="2" />
    </LinearLayout>
</LinearLayout>
