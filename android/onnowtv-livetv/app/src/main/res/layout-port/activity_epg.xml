<?xml version="1.0" encoding="utf-8"?>
<!-- PORTRAIT (phone) EPG layout — v2.17.0.
     Same view IDs as layout/activity_epg.xml so EpgActivity binds
     identically; only the arrangement changes:
       · icon rail  → horizontal top bar
       · categories → horizontal chip strip (LayoutManager switched
         to HORIZONTAL in EpgActivity when in portrait)
       · channels   → full-width vertical list
       · guide      → compact panel docked at the bottom
     Everything is finger-first: RecyclerViews scroll natively and
     every element already uses setOnClickListener. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/livetv_bg">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/livetv_bg">

    <!-- ───────── TOP ICON BAR (was the left rail) ───────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#0E1422">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="V2"
            android:textColor="@color/livetv_accent_red"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.04"
            android:shadowColor="#80FF2535"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="14" />

        <Space android:layout_width="0dp" android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton android:id="@+id/rail_home"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:padding="9dp"
            android:src="@drawable/ic_nav_home"
            android:background="@drawable/rail_icon_bg"
            android:focusable="true"
            android:contentDescription="Home" />

        <ImageButton android:id="@+id/rail_search"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:padding="9dp"
            android:src="@drawable/ic_nav_search"
            android:background="@drawable/rail_icon_bg"
            android:focusable="true"
            android:contentDescription="Search" />

        <ImageButton android:id="@+id/rail_refresh"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:padding="9dp"
            android:src="@drawable/ic_refresh"
            android:background="@drawable/rail_icon_bg"
            android:focusable="true"
            android:contentDescription="Refresh" />

        <ImageButton android:id="@+id/rail_library"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:padding="9dp"
            android:src="@drawable/ic_nav_library"
            android:background="@drawable/rail_icon_bg"
            android:focusable="true"
            android:contentDescription="My Library" />

        <TextView android:id="@+id/rail_ppv"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="PPV"
            android:textColor="@color/rail_ppv_text_color"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:background="@drawable/rail_ppv_bg"
            android:focusable="true"
            android:contentDescription="Pay-per-view" />

        <ImageButton android:id="@+id/rail_fullscreen"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:padding="9dp"
            android:src="@drawable/ic_nav_fullscreen"
            android:background="@drawable/rail_icon_bg"
            android:focusable="true"
            android:contentDescription="Fullscreen" />

        <ImageButton android:id="@+id/rail_signout"
            android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:padding="9dp"
            android:src="@drawable/ic_nav_signout"
            android:background="@drawable/rail_icon_bg"
            android:focusable="true"
            android:contentDescription="Sign out" />
    </LinearLayout>

    <!-- ───────── HERO (compact) ───────── -->
    <FrameLayout
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="190dp">

        <ImageView
            android:id="@+id/hero_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:adjustViewBounds="false"
            android:contentDescription="@null" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/livetv_bg"
            android:alpha="0.55" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/hero_gradient" />

        <View
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_gravity="bottom"
            android:background="@drawable/hero_bottom_fade" />

        <!-- Live preview card — small 16:9, top-right -->
        <FrameLayout
            android:id="@+id/preview_card"
            android:layout_width="164dp"
            android:layout_height="92dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/preview_card_bg"
            android:padding="3dp">

            <ImageView
                android:id="@+id/preview_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#0A0F1A"
                android:contentDescription="@null" />

            <View
                android:id="@+id/preview_thumb_fade"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="bottom"
                android:background="@drawable/hero_bottom_fade" />

            <TextView
                android:id="@+id/preview_idle_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/livetv_fg_bright"
                android:textSize="8sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"
                android:text="TAP A CHANNEL TO PLAY"
                android:shadowColor="#000000"
                android:shadowDx="0" android:shadowDy="1" android:shadowRadius="3" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/preview_player_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:resize_mode="fit"
                app:use_controller="false"
                app:surface_type="texture_view"
                android:background="#000000"
                android:visibility="gone" />

            <tv.onnowtv.livetv.ui.OrbitalLoaderView
                android:id="@+id/preview_buffer_loader"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/preview_live_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:layout_margin="6dp"
                android:background="@drawable/preview_live_badge_bg"
                android:fontFamily="monospace"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="LIVE"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/preview_mini_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="6dp"
                android:layout_marginBottom="5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_mini_play"
                    android:contentDescription="@null" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="6dp"
                    android:background="#33FFFFFF">

                    <View
                        android:id="@+id/preview_mini_progress"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:background="#5C9CFF" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:fontFamily="monospace"
                    android:text="LIVE"
                    android:textColor="#E6EAF2"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16" />

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_mini_audio"
                    android:contentDescription="@null" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginTop="14dp"
            android:layout_marginStart="16dp"
            android:textColor="@color/livetv_fg_bright"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:text="" />

        <!-- Hero text — bottom-left, clear of the preview card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hero_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/livetv_accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.28"
                android:text="LIVE TV" />

            <TextView
                android:id="@+id/hero_channel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/livetv_fg"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="LIVE TV" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/livetv_accent"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.26"
                    android:text="NOW" />

                <TextView
                    android:id="@+id/hero_now_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/livetv_accent"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14"
                    android:text="" />

                <TextView
                    android:id="@+id/hero_now_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/livetv_fg_bright"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="" />
            </LinearLayout>

            <TextView
                android:id="@+id/hero_synopsis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/livetv_fg_dim"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="8dp"
                android:background="#1AFFFFFF">

                <View
                    android:id="@+id/hero_progress"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@color/livetv_accent" />
            </FrameLayout>

            <TextView
                android:id="@+id/hero_up_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/livetv_fg_dimmer"
                android:textSize="9sp"
                android:letterSpacing="0.18"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />

            <!-- Hidden views (legacy id references kept for safety) -->
            <LinearLayout
                android:id="@+id/hero_up_next_card"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:orientation="vertical">
                <TextView android:id="@+id/up_next_1_time" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/up_next_1_title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/up_next_2_time" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/up_next_2_title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/up_next_3_time" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/up_next_3_title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <TextView
                android:id="@+id/hero_up_next_time"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/hero_up_next_title"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <!-- ───────── CATEGORY STRIP (horizontal on phone) ───────── -->
    <LinearLayout
        android:id="@+id/categories_sidebar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp">

        <LinearLayout
            android:id="@+id/whatson_pill"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/whatson_pill_bg"
            android:focusable="true"
            android:clickable="true">

            <View
                android:id="@+id/whatson_pill_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/whatson_live_dot" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:letterSpacing="0.06"
                    android:text="WHAT'S ON LIVE" />

                <TextView
                    android:id="@+id/whatson_pill_sublabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:textColor="#FFF9E4D1"
                    android:textSize="8sp"
                    android:letterSpacing="0.20"
                    android:text="SPORTS · RIGHT NOW" />
            </LinearLayout>

            <TextView
                android:id="@+id/whatson_pill_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:letterSpacing="0.14"
                android:text="0" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categories_list"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:descendantFocusability="afterDescendants"
            android:focusable="false"
            android:nestedScrollingEnabled="true"
            android:clipToPadding="false"
            android:overScrollMode="never" />
    </LinearLayout>

    <!-- ───────── CHANNELS (full width) ───────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="@color/livetv_accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.24"
                android:text="PLAYING NOW" />

            <TextView
                android:id="@+id/channel_count_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/channel_count_chip_bg"
                android:fontFamily="monospace"
                android:textColor="@color/livetv_accent"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"
                android:text="0 CHANNELS" />
        </LinearLayout>

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/whatson_sport_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:descendantFocusability="afterDescendants"
            android:focusable="false"
            android:nestedScrollingEnabled="true"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channels_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="afterDescendants"
            android:focusable="false"
            android:nestedScrollingEnabled="true"
            android:clipToPadding="false"
            android:overScrollMode="never" />
    </LinearLayout>

    <!-- ───────── GUIDE (compact bottom panel) ───────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="#0B111E">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/guide_today"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="@color/livetv_accent"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.24"
                android:text="COMING UP NEXT" />

            <TextView
                android:id="@+id/guide_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/livetv_fg_dim"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.18"
                android:text="" />
        </LinearLayout>

        <TextView
            android:id="@+id/guide_channel_header"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/guide_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="afterDescendants"
            android:focusable="false"
            android:nestedScrollingEnabled="true"
            android:clipToPadding="false"
            android:overScrollMode="never" />
    </LinearLayout>
</LinearLayout>

<!-- ===== SEARCH OVERLAY (phone padding) ===== -->
<LinearLayout
    android:id="@+id/search_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F00A1224"
    android:visibility="gone"
    android:focusable="true"
    android:descendantFocusability="afterDescendants"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textColor="@color/livetv_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.32"
            android:text="SEARCH" />

        <TextView
            android:id="@+id/search_overlay_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/channel_count_chip_bg"
            android:fontFamily="monospace"
            android:textColor="@color/livetv_accent"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.20"
            android:text="" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/search_bar_bg"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search_small"
            android:contentDescription="@null" />

        <EditText
            android:id="@+id/search_overlay_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:textColor="@color/livetv_fg"
            android:textColorHint="@color/livetv_fg_dimmer"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:hint="Search channels and programmes…"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <ImageButton
            android:id="@+id/search_overlay_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="12dp"
            android:src="@drawable/ic_exit"
            android:background="@drawable/rail_icon_bg"
            android:focusable="true"
            android:contentDescription="Close" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_overlay_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:nestedScrollingEnabled="true"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <TextView
        android:id="@+id/search_overlay_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:fontFamily="monospace"
        android:textColor="@color/livetv_fg_dimmer"
        android:textSize="13sp"
        android:letterSpacing="0.16"
        android:text="Start typing to search every channel and every programme."
        android:visibility="visible" />
</LinearLayout>

</FrameLayout>
