<?xml version="1.0" encoding="utf-8"?>
<!--
    Vesper cold-start splash background.

    Painted by the OS the INSTANT the launcher hands control to the
    app — before Application.onCreate + Activity.onCreate even run.
    Users see the brand backdrop immediately instead of a black
    system frame or the loader spinner popping in ~1s late while
    Android System WebView cold-boots.

    v2.16.23 — Stripped the previous #FF2535 red radial glow.  User:
    "I don't like that weird red glow — should just be opening
    directly up straight into the login screen."  The login page
    itself renders a subtle cyan accent, so the splash now sits as
    a flat #06080F dark-navy panel that transitions imperceptibly
    into the WebView's first paint.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid dark navy base — matches @color/vesper_bg -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF06080F" />
        </shape>
    </item>
</layer-list>
