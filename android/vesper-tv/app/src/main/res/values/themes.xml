<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base theme — dark, no action bar, vesper background -->
    <style name="Theme.Vesper" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/vesper_bg</item>
        <item name="android:colorBackground">@color/vesper_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowContentTransitions">false</item>
    </style>

    <!-- Fullscreen theme used by MainActivity -->
    <style name="Theme.Vesper.Fullscreen" parent="Theme.Vesper">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">
            shortEdges
        </item>
    </style>

    <!--
        v2.16.7 — Cold-start splash.  Applied to MainActivity in the
        manifest so the OS paints @drawable/splash_vesper as the very
        first frame the user sees when tapping the app icon, hiding
        the ~1s WebView cold-boot delay behind branded artwork.
        MainActivity.onCreate calls setTheme(Fullscreen) BEFORE
        super.onCreate so all subsequent theming (typography, dialogs)
        still comes from the normal Fullscreen theme.
    -->
    <style name="Theme.Vesper.Splash" parent="Theme.Vesper.Fullscreen">
        <item name="android:windowBackground">@drawable/splash_vesper</item>
    </style>
</resources>
